G {{ tex \nonterm G }} :: env_ ::= {{ com typing contexts }}
  | empty        ::   :: nil  {{ com empty }}
  | G , x : t    ::   :: var  {{ com variable assumption }}
  | G, a         ::   :: tvar {{ com type variable assumption }}
defns Jtype :: '' ::=
defn G |- e : t :: :: typing :: T_ {{ com term typing }} by

x : t in G
---------- :: Var
G |- x : t

G, x:t1 |- e : t2
----------------------- :: Abs
G |- \x:t1.e : t1 -> t2

G |- e1 : t' -> t
G |- e2 : t'
----------------- :: App
G |- e1 e2 : t

G, a |- e : t
-------------------- :: TAbs
G |- /\a.e : all a.t

G |- e : all a.t'
G |- t ok
